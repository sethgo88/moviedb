{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm:*)",
      "Bash(git push:*)",
      "mcp__github__issue_write",
      "WebFetch(domain:api.github.com)",
      "Read(//c/web/moviedb/src/lib//**)",
      "Read(//c/web/moviedb/src//**)",
      "Bash(xargs grep:*)",
      "Bash(git config:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "eval \"$(fnm env)\" 2>/dev/null; FILE=$(jq -r '.tool_input.file_path // empty'); if [[ \"$FILE\" == *.ts || \"$FILE\" == *.tsx ]]; then cd /c/web/moviedb && pnpm biome check --write \"$FILE\"; fi"
          }
        ]
      }
    ]
  }
}
